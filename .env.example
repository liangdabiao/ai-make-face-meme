# ===== apiz.ai 异步任务 API =====
# 用于图像生成。注册并获取 Key：https://api.apiz.ai
APIZ_API_KEY=your_apiz_api_key_here
APIZ_API_BASE_URL=https://api.apiz.ai/api/v3
APIZ_MODEL=fal-ai/nano-banana-2

# 轮询参数（可选）
# 任务最大等待时间（毫秒）
APIZ_TIMEOUT_MS=300000
# 轮询间隔（毫秒）
APIZ_POLL_INTERVAL_MS=3000

# 参考图公网上传（apiz 要求 image_urls 是 HTTP/HTTPS URL）
# 默认使用 uguu.se 免费图床（form-data: files[]=@file）
# 也可以换成自建服务或 Vercel Blob
APIZ_REFERENCE_UPLOAD_URL=https://uguu.se/upload
APIZ_REFERENCE_UPLOAD_FIELD=files[]
